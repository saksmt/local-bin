#!/bin/bash

##
# Borrowed and adapted from https://gist.github.com/valer-cara/2eceb546d4de7989675010bd20c72a1d
##

source /usr/local/etc/colors.sh

KAFKA_BROKER_PORT=9092

KAFKA_SERVICE="${KAFKA_SERVICE:-kafka}"
# empty for current one from current context
KAFKA_NAMESPACE="${KAFKA_NAMESPACE}"

KUBERNETES_CLUSTER_DOMAIN="${KUBERNETES_CLUSTER_DOMAIN:-cluster.local}"

iptablesTmpFile="$(mktemp --tmpdir kafka-kfw.${selfPID}.iptables.XXXXXXX)"
hostsTmpFile="$(mktemp --tmpdir kafka-kfw.${selfPID}.hosts.XXXXXXX)"
selfPID=$$

function wakeupSudo {
  sudo echo "${error}${red}You've given access to everything! HA-HA-HA${clr}"
}

function finish {
  wakeupSudo
  echo "${info}Cleaning up ${highlight}/etc/hosts${clr}"
  sudo sed -i "/\# kafka-kfw routing PID\:${selfPID} {/,/\# } kafka-kfw routing PID\:${selfPID}/d" /etc/hosts

  echo -n "${info}Closing all port forwards.. "

  teardownDNAT
  rm -f "${iptablesTmpFile}"
  rm -f "${hostsTmpFile}"

  forwarers="$(jobs -p)"
  [[ n"${forwarders}" != n ]] && kill $forwarders

  echo "Bye!"
}
trap finish EXIT TERM KILL

namespaceArg=
if [[ n"${KAFKA_NAMESPACE}" != n ]]; then
  namespaceArg="-n ${KAFKA_NAMESPACE}"
else
  KAFKA_NAMESPACE=$(kubectl config view --minify --output 'jsonpath={..namespace}')
fi


function setupDNAT {
  cat $iptablesTmpFile | xargs -L1 sudo iptables -A OUTPUT
}

function teardownDNAT {
  cat $iptablesTmpFile | xargs -L1 sudo iptables -D OUTPUT
}

function getPodSelector {
  kubectl $namespaceArg get "svc/${KAFKA_SERVICE}" -o go-template \
    --template '{{ with $l := .spec.selector }}{{ range $k, $v := $l }}{{ $k }}={{ $v }},{{ end }}{{ end }}'
}

function getPods {
  selector=$(getPodSelector)
  kubectl $namespaceArg get pods -l ${selector:0:-1} -o go-template --template="{{range .items}}{{.metadata.name}}:{{.status.podIP}} {{end}}"
}

function init {
  {
    echo
    echo "# kafka-kfw routing PID:${selfPID} {"
    echo "# DO NOT EDIT THIS BLOCK! AND MORE IMPORTANTLY LINE ABOVE AND SIMILAR LINE BELOW!"
    echo "# Remove this block manually if there is no process with PID mentioned above"
    echo
    echo "127.0.0.1  ${KAFKA_SERVICE}.${KAFKA_NAMESPACE}.svc.${KUBERNETES_CLUSTER_DOMAIN}"
  } > ${hostsTmpFile}
  i=0
  for line in $(getPods); do
    IFS=: read podName podIP <<<$line
    portOnHost=$((KAFKA_BROKER_PORT + i))
    let "i++"

    kubectl $namespaceArg port-forward pod/$podName $portOnHost:${KAFKA_BROKER_PORT} >/dev/null &

    echo '127.0.0.1 '" ${podName}.${KAFKA_SERVICE}.${KAFKA_NAMESPACE}.svc.${KUBERNETES_CLUSTER_DOMAIN}" >> ${hostsTmpFile}

    echo "-t nat -p tcp -d $podIP --dport ${KAFKA_BROKER_PORT} -j DNAT --to-destination 127.0.0.1:$portOnHost" >> $iptablesTmpFile
  done
  {
    echo
    echo "# END OF AUTO-GENERATED BLOCK. DO NOT REMOVE LINE BELOW"
    echo "# } kafka-kfw routing PID:${selfPID}"
  } >> ${hostsTmpFile}
}


init

wakeupSudo
setupDNAT

cat ${hostsTmpFile} | sudo tee -a /etc/hosts >/dev/null

echo "${success}Forwarding ${highlight}${KAFKA_SERVICE}${clr} and all associated pods"

wait
