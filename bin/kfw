#!/usr/bin/env bash

shopt -s extglob

TEMP="$(getopt -o 'n:g' -l 'namespace:global' -- "${@}")" || exit 1
eval set -- "${TEMP}"
unset TEMP

namespaceArg=""
addressArg=""

while true; do
  case "${1}" in
    '-n'|'--namespace' )
      namespaceArg="-n ${2}"
      shift 2
      ;;
    '-g'|'--global' )
      shift
      addressArg="--address 0.0.0.0"
      ;;
    '--')
      shift
      break
      ;;
  esac
done


port=
service=

case "${1}" in
  ch | clickhouse )
    port=8123
    service=clickhouse
    ;;
  +([[:digit:]]))
    port="${1}"
    service="${2}"
    ;;
  * )
    case "${2}" in
      +([[:digit:]]))
        port="${2}"
        service="${1}"
        ;;
      * )
        echo "${error}Unknown service" >&2;
        exit 1;
        ;;
    esac
esac

[[ n"${service}" == n ]] && {
  echo "${error}You need to specify service for port ${port}" >&2
  exit 1;
}

kubectl ${namespaceArg} port-forward ${addressArg} service/${service} ${port}

