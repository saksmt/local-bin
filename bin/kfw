#!/usr/bin/env bash

shopt -s extglob

port=
service=

case "${1}" in
  ch | clickhouse )
    port=8123
    service=clickhouse
    ;;
  +([[:digit:]]))
    port="${1}"
    service="${2}"
    ;;
  * )
    case "${2}" in
      +([[:digit:]]))
        port="${2}"
        service="${1}"
        ;;
      * )
        echo "${error}Unknown service" >&2;
        exit 1;
        ;;
    esac
esac

[[ n"${service}" == n ]] && {
  echo "${error}You need to specify service for port ${port}" >&2
  exit 1;
}

kubectl port-forward service/${service} ${port}


